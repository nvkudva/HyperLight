{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "permission"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "allow-set-hotkey",
    "allow-request-keyboard-access",
    "allow-keyboard-access-granted",
    "allow-start-permission-drag",
    "allow-close-permission-helper",
    "allow-dock-icon-visible",
    "allow-set-dock-icon-visible"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:8585/*",
      "http://localhost:8585/*"
    ]
  }
}
