{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:8585/*",
      "http://localhost:8585/*"
    ]
  }
}
