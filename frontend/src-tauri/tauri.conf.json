{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hyperlight",
  "version": "0.1.0",
  "identifier": "com.hyperlight.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8585",
    "beforeDevCommand": "",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hyperlight",
        "width": 1140,
        "height": 780,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        },
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8585; img-src 'self' data: blob: http://127.0.0.1:8585; media-src 'self' blob: http://127.0.0.1:8585; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0",
      "files": {
        "Resources/PrivacyInfo.xcprivacy": "./PrivacyInfo.xcprivacy"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "\u00a9 2026 Vijay Krishna Kudva",
    "shortDescription": "Private, on-device search for your Mac"
  }
}
